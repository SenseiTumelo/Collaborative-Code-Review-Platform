{
  "info": {
    "name": "Collaborative Code Review Assessment",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Set token to the acting user login JWT. Replace IDs with response IDs. Delete requests remove assessment data; run them at the end."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "userId",
      "value": "1"
    },
    {
      "key": "reviewerId",
      "value": "2"
    },
    {
      "key": "projectId",
      "value": "1"
    },
    {
      "key": "submissionId",
      "value": "1"
    },
    {
      "key": "commentId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/health",
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "Register submitter",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/register",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Student\",\n  \"email\": \"student@example.com\",\n  \"password\": \"Password123!\",\n  \"role\": \"submitter\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Register reviewer",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/register",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Reviewer\",\n  \"email\": \"reviewer@example.com\",\n  \"password\": \"Password123!\",\n  \"role\": \"reviewer\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"student@example.com\",\n  \"password\": \"Password123!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Own profile",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/users/{{userId}}"
      }
    },
    {
      "name": "Update profile",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/users/{{userId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Student Updated\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Create project",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/projects",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Assessment\",\n  \"description\": \"Collaborative code review\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "List projects",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/projects"
      }
    },
    {
      "name": "Assign reviewer",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/projects/{{projectId}}/members",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": 2\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "List members",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/projects/{{projectId}}/members"
      }
    },
    {
      "name": "Submit code",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/submissions",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"projectId\": 1,\n  \"title\": \"Counter\",\n  \"code\": \"const a = 1;\\nconsole.log(a);\",\n  \"filename\": \"counter.js\",\n  \"language\": \"javascript\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "List submissions",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/projects/{{projectId}}/submissions"
      }
    },
    {
      "name": "View submission",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/submissions/{{submissionId}}"
      }
    },
    {
      "name": "Mark in review",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/submissions/{{submissionId}}/status",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"in_review\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Add inline comment",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/submissions/{{submissionId}}/comments",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"body\": \"Use a descriptive variable name\",\n  \"line\": 1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "List comments",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/submissions/{{submissionId}}/comments"
      }
    },
    {
      "name": "Update comment",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/comments/{{commentId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"body\": \"Consider naming it count\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Delete comment",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/comments/{{commentId}}"
      }
    },
    {
      "name": "Request changes",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/submissions/{{submissionId}}/request-changes",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"feedback\": \"Improve variable names\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Edit code",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/submissions/{{submissionId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"code\": \"const count = 1;\\nconsole.log(count);\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Resubmit",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/submissions/{{submissionId}}/status",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"pending\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Approve",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/submissions/{{submissionId}}/approve",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"feedback\": \"Looks good\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Review history",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/submissions/{{submissionId}}/reviews"
      }
    },
    {
      "name": "Activity feed",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/users/{{userId}}/notifications"
      }
    },
    {
      "name": "Statistics",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/projects/{{projectId}}/stats"
      }
    },
    {
      "name": "Remove reviewer",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/projects/{{projectId}}/members/{{reviewerId}}"
      }
    },
    {
      "name": "Delete submission",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/submissions/{{submissionId}}"
      }
    },
    {
      "name": "Delete project",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/projects/{{projectId}}"
      }
    },
    {
      "name": "Delete own account",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/users/{{userId}}"
      }
    }
  ]
}